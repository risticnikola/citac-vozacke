{
  appId: "com.citmec.bridge",
  productName: "Vehicle Card Bridge",
  copyright: "Copyright © 2026",

  directories: {
    output: "dist-electron",
    buildResources: "build",
  },

  files: [
    "dist/**/*",
    "wizard/**/*",
    "settings/**/*",
    "package.json",
  ],

  extraResources: [
    { from: "assets/", to: "assets/", filter: ["*.png"] },
    { from: ".env", to: ".env" },
  ],

  win: {
    target: [{ target: "nsis", arch: ["x64"] }],
    icon: "build/icon.png",
    extraResources: [
      { from: "native/citacVozacke.exe",         to: "native/citacVozacke.exe" },
      { from: "native/eVehicleRegistrationAPI.dll", to: "native/eVehicleRegistrationAPI.dll" },
    ],
  },

  nsis: {
    oneClick: true,
    perMachine: false,
    shortcutName: "Vehicle Card Bridge",
    include: "build/installer.nsh",
  },

  mac: {
    target: [{ target: "dmg", arch: ["universal"] }],
    icon: "build/icon.png",
    category: "public.app-category.utilities",
  },

  linux: {
    target: [{ target: "AppImage", arch: ["x64"] }],
    icon: "build/icons",
    category: "Utility",
  },

  // No publish server yet — distribute installers manually via download link
  publish: null,
}
